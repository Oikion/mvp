# ===========================================
# OIKION MVP - Environment Variables Example
# ===========================================
# Copy this file to .env.local and fill in your values

# ----- DATABASE (Prisma Postgres) -----
# Use a pooled connection string for serverless environments
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
# Direct connection URL (bypasses connection pooler, used for migrations)
DIRECT_DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ----- CLERK AUTHENTICATION -----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
# Optional: Proxy URL for custom domain
# NEXT_PUBLIC_CLERK_PROXY_URL=""

# ----- APPLICATION -----
NEXT_PUBLIC_APP_NAME="Oikion"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_V="1.0.0-pre-release"

# ----- PLATFORM ADMIN -----
# Comma-separated list of admin emails (checked in production)
PLATFORM_ADMIN_EMAILS="admin@example.com"
# Development-only admin emails (disabled in production)
PLATFORM_ADMIN_DEV_EMAILS="dev@example.com"

# ----- AUTH.JS (if using Auth.js alongside Clerk) -----
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ----- GOOGLE OAUTH -----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----- STRIPE PAYMENTS -----
STRIPE_API_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PLAN_ID=""
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PLAN_ID=""
NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PLAN_ID=""
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PLAN_ID=""

# ----- EMAIL (Resend) -----
# Verified sending domain: mail.oikion.com
# From address is hardcoded to: Oikion <noreply@mail.oikion.com>
# No EMAIL_FROM env var is used — the sender address is fixed to the verified Resend domain.
RESEND_API_KEY="re_..."
# Where feedback/admin emails are delivered (default: contact@oikion.com)
FEEDBACK_EMAIL="contact@oikion.com"

# ----- DIGITAL OCEAN SPACES (File Storage) -----
DO_ENDPOINT="https://fra1.digitaloceanspaces.com"
DO_REGION="fra1"
DO_BUCKET="your-bucket"
DO_ACCESS_KEY_ID=""
DO_ACCESS_KEY_SECRET=""

# ----- OPENAI -----
# Server-side only - do not use NEXT_PUBLIC_ prefix
OPENAI_API_KEY=""

# ----- ANTHROPIC -----
ANTHROPIC_API_KEY=""

# ----- CAL.COM INTEGRATION (Legacy - Not Currently Used) -----
# Note: Calendar functionality is now handled internally
# These variables are kept for backwards compatibility
CALCOM_API_KEY=""
CALCOM_API_URL="https://api.cal.com/v1"
CALCOM_WEBHOOK_SECRET=""

# ----- GITHUB -----
# Used for repository stars feature (server-side only)
GITHUB_TOKEN=""
GITHUB_REPO_API="https://api.github.com/repos/YourOrg/YourRepo"

# ----- UPLOADTHING -----
UPLOADTHING_TOKEN=""

# ----- JWT -----
JWT_SECRET=""

# ----- POSTHOG ANALYTICS -----
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
POSTHOG_API_KEY=""

# ----- ABLY (Real-time messaging) -----
ABLY_API_KEY=""

# ----- N8N INTEGRATION -----
N8N_BASE_URL="http://localhost:5678"
N8N_API_KEY=""
N8N_WEBHOOK_SECRET=""
N8N_ALLOWED_ORIGINS="http://localhost:3000"

# ----- XE.GR INTEGRATION -----
XE_GR_USERNAME=""
XE_GR_PASSWORD=""
XE_GR_BASE_URL="https://www.xe.gr"
XE_GR_AUTHTOKEN=""

# ----- RATE LIMITING -----
RATE_LIMIT_ENABLED="true"

# ----- UPSTASH REDIS (Rate Limiting + Caching) -----
# Get from console.upstash.com → Redis Database → REST API tab
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ----- CRON JOBS -----
CRON_SECRET=""

# ----- EXTERNAL API CORS -----
# Comma-separated list of allowed origins for /api/v1/* routes
# Example: "https://app.example.com,https://n8n.example.com"
ALLOWED_API_ORIGINS=""

# ----- APP ACCESS GATE -----
# 6-digit numeric code required to access the app (acts as a beta access PIN)
# If not set, the gate is disabled — safe to leave unset in local dev
APP_ACCESS_CODE=""
# Secret used to sign the access cookie (HMAC-SHA256). Required when APP_ACCESS_CODE is set.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value instantly invalidates all existing access sessions.
APP_ACCESS_COOKIE_SECRET=""

# ----- FIELD-LEVEL ENCRYPTION -----
# AES-256-GCM key for encrypting sensitive data at rest (clients, messages, documents, etc.)
# REQUIRED in production. Must be exactly 64 hex characters (= 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this key after data has been encrypted will make existing data unreadable.
#          Back up the key securely and never commit it to version control.
SECRETS_ENCRYPTION_KEY=""

# ----- INTERNAL TOOL SECRET -----
# Used for authenticating internal API calls between services
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOOL_SECRET=""

# ----- VERCEL BLOB STORAGE -----
MVP_READ_WRITE_TOKEN=""
