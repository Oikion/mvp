{
  "name": "oikion",
  "version": "1.0.0-pre-release",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate && node scripts/sync-version.js",
    "dev": "next dev --turbopack --experimental-https --experimental-https-key ./localhost-key.pem --experimental-https-cert ./localhost.pem",
    "predev:verbose": "node scripts/sync-version.js",
    "dev:verbose": "NODE_OPTIONS='--trace-warnings' DEBUG=next:* next dev --webpack --experimental-https --experimental-https-key ./localhost-key.pem --experimental-https-cert ./localhost.pem 2>&1 | tee dev.log",
    "predev:debug": "node scripts/sync-version.js",
    "dev:debug": "NODE_OPTIONS='--trace-warnings --trace-uncaught' DEBUG=* next dev --webpack --experimental-https --experimental-https-key ./localhost-key.pem --experimental-https-cert ./localhost.pem 2>&1 | tee dev-debug.log",
    "predev:profile": "node scripts/sync-version.js",
    "dev:profile": "node scripts/profile-startup.js next dev --webpack --experimental-https --experimental-https-key ./localhost-key.pem --experimental-https-cert ./localhost.pem",
    "predev:http": "node scripts/sync-version.js",
    "dev:http": "next dev --webpack",
    "predev:webpack": "node scripts/sync-version.js",
    "dev:webpack": "next dev --webpack --experimental-https --experimental-https-key ./localhost-key.pem --experimental-https-cert ./localhost.pem",
    "dev:turbo": "NEXT_TURBOPACK=1 next dev --turbopack --experimental-https --experimental-https-key ./localhost-key.pem --experimental-https-cert ./localhost.pem",
    "clean:next": "rm -rf .next",
    "dev:clean": "pnpm clean:next && pnpm dev",
    "dev:legacy": "node server.js",
    "prebuild": "node scripts/sync-version.js",
    "build": "prisma generate --no-engine && prisma migrate deploy && next build --webpack",
    "prestart": "node scripts/sync-version.js",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status",
    "db:validate": "tsx scripts/validate-migrations.ts",
    "seed:test": "tsx scripts/seed-test-data.ts",
    "dek:migrate:dry": "tsx scripts/migrate-to-org-dek.ts --dry-run",
    "dek:migrate": "tsx scripts/migrate-to-org-dek.ts",
    "dek:verify": "tsx scripts/migrate-to-org-dek.ts --verify",
    "migrate:colors": "tsx scripts/design-system/migrate-colors.ts",
    "migrate:colors:dry": "tsx scripts/design-system/migrate-colors.ts --dry-run",
    "generate:color-pdf": "npx tsx scripts/generate-color-palette-pdf.ts",
    "purge-db": "ts-node scripts/purge-database.ts"
  },
